# ---------------------------------------------------------------------------
# Machine Brain - variaveis de ambiente
# Copie para .env.local e preencha.
# ---------------------------------------------------------------------------

# Chave da API da Anthropic. Sem ela a plataforma sobe em MODO DEMONSTRACAO:
# a interface inteira funciona, mas as respostas da IA sao substituidas por um
# aviso explicito em vez de conteudo inventado.
ANTHROPIC_API_KEY=

# Modelos usados. O primeiro atende o Professor IA e o Jurista IA; o segundo
# atende tarefas de menor custo (classificacao, titulos, extracao).
MB_MODEL_PRINCIPAL=claude-opus-5
MB_MODEL_RAPIDO=claude-sonnet-5

# Segredo usado para assinar o cookie de sessao (troque em producao).
MB_SESSION_SECRET=troque-este-valor-por-uma-string-longa-e-aleatoria

# Caminho do banco SQLite.
MB_DATABASE_PATH=./data/machine-brain.db
