# ---------------------------------------------------------------------------
# DRAP JURÍDICO — variáveis de ambiente
# Copie para .env.local e preencha.
# ---------------------------------------------------------------------------

# --- Supabase (backend e banco) --------------------------------------------
# Painel do projeto → Project Settings → API.
# As duas são públicas por natureza: a chave anon não dá acesso a nada sozinha,
# porque quem separa os dados de cada usuário é o RLS definido em
# supabase/migrations. NUNCA coloque aqui a chave service_role — ela ignora o
# RLS e não é usada por esta aplicação em lugar nenhum.
#
# Atenção: variáveis NEXT_PUBLIC_ entram no bundle na hora do build. Depois de
# alterá-las, refaça o build.
#
# O painel novo (Project Settings → API Keys) entrega uma chave publicável no
# formato sb_publishable_...; projetos mais antigos ainda mostram a chave anon
# em JWT (eyJ...), na aba Legacy API keys. A aplicação aceita as duas: preencha
# a que o seu painel mostrou e deixe a outra vazia.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Modelos de IA ----------------------------------------------------------
# São quatro modos, e BASTA UM. Sem nenhuma chave a plataforma sobe em MODO
# DEMONSTRAÇÃO: a interface inteira funciona, mas as respostas da IA são
# substituídas por um aviso explícito em vez de conteúdo jurídico inventado.
#
# Os três primeiros têm nível gratuito e existem para a plataforma rodar antes
# de haver plano pago. A ordem abaixo é a de preferência quando o usuário não
# escolhe: gratuitos primeiro, pago por último.

# Modo "Estudo" — o mais rápido. https://console.groq.com/keys
GROQ_API_KEY=

# Modo "Pesquisa" — contexto longo. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Modo "Debate" — modelos abertos variados. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Modo "Parecer" — o mais criterioso, e o único pago.
ANTHROPIC_API_KEY=

# Modelo de cada provedor. Os padrões estão no código; troque aqui quando o
# provedor aposentar um modelo do nível gratuito — isso acontece com frequência,
# e é por isso que são variáveis e não constantes.
MB_MODEL_GROQ=llama-3.3-70b-versatile
MB_MODEL_GEMINI=gemini-2.0-flash
MB_MODEL_OPENROUTER=meta-llama/llama-3.3-70b-instruct:free
MB_MODEL_PRINCIPAL=claude-opus-5
MB_MODEL_RAPIDO=claude-sonnet-5
